# ==============================================================================
# ⚡ VORTEX APEX E-COMMERCE ENGINE // ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# JSON Web Token Secret Key (Must be at least 32 characters long)
JWT_SECRET=

# Supabase PostgreSQL Database Connection URL (Keep private, never share or commit)
# Format: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@[HOST]:[PORT]/postgres
SUPABASE_URL=

# Supabase Public API Key (Anon / Public key)
SUPABASE_KEY=
